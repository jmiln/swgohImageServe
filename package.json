{
    "name": "imgserv",
    "version": "2.0.1",
    "description": "",
    "type": "module",
    "main": "index.ts",
    "scripts": {
        "prepare": "husky",
        "setup": "npm install && npm run prepare",
        "start": "node --env-file=.env index.ts",
        "lint": "biome check --no-errors-on-unmatched .",
        "lint:write": "biome check --write --no-errors-on-unmatched .",
        "test": "node --test test/**/*.test.ts",
        "changelog:draft": "scripts/changelog-draft.sh",
        "changelog:write": "scripts/changelog-draft.sh --write",
        "changelog:release": "scripts/changelog-draft.sh --write --release",
        "release": "npm version --ignore-scripts=false",
        "version": "scripts/changelog-draft.sh --write --stage --release $npm_package_version"
    },
    "author": "",
    "license": "ISC",
    "dependencies": {
        "@swgoh-utils/comlink": "^2.0.0",
        "chart.js": "^4.6.1",
        "ejs": "^7.0.2",
        "express": "^5.3.0",
        "pino": "^10.4.0",
        "puppeteer": "^25.16.0",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.6.2",
        "@types/ejs": "^3.1.5",
        "@types/express": "^5.0.6",
        "@types/node": "^26.6.5",
        "husky": "^9.1.7",
        "pino-pretty": "^13.2.0",
        "typescript": "^7.0.2"
    }
}
