<!doctype html>
<html lang="en">
<head>
    <link rel="stylesheet" href="/css/styles.css">
    <base href="<%= baseURL %>">
    <style>
        body {
            background-image: linear-gradient(#1A2E37, #1A506F);
            padding: 10px;
            margin: 0;
        }
        #wrapper {
            width: <%= width %>px;
        }
        #player-header {
            color: white;
            font-size: 28px;
            font-weight: bold;
            text-align: center;
            padding-bottom: 8px;
        }
        .section-label {
            color: white;
            font-size: 22px;
            font-weight: bold;
            padding: 8px 0;
        }
        .squad-row {
            display: flex;
            flex-wrap: nowrap;
        }
        .arena-divider {
            height: 3px;
            background: linear-gradient(to right, #3a7ab5, #1a506f, #3a7ab5);
            margin: 12px 0;
            border-radius: 2px;
        }
    </style>
</head>

<body>
    <div id="wrapper">
        <% if (name || allyCode) { %>
        <div id="player-header">
            <% if (name && allyCode) { %><%= name %> (<%= allyCode %>)<% } else if (name) { %><%= name %><% } else { %><%= allyCode %><% } %>
        </div>
        <% } %>
        <div class="section-label">Character Arena - Rank <%= charRank %></div>
        <div class="squad-row">
            <% charTeam.forEach(function(char) { %>
                <%- include('../partials/char', {char: char}); %>
            <% }); %>
        </div>
        <div class="arena-divider"></div>
        <div class="section-label">Fleet Arena - Rank <%= fleetRank %></div>
        <div class="squad-row">
            <% fleetTeam.forEach(function(char) { %>
                <%- include('../partials/char', {char: char}); %>
            <% }); %>
        </div>
    </div>
</body>
</html>
